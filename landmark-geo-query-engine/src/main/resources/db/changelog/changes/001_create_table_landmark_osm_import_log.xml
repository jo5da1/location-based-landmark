<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="001_create_table_landmark_osm_import_log" author="jod">

        <createTable tableName="landmark_osm_import_log">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="import_id" type="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="start_time" type="timestamp">
                <constraints nullable="false" />
            </column>
            <column name="end_time" type="timestamp"/>
            <column name="import_status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="import_to" type="varchar(1)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(100)"/>

        </createTable>
    </changeSet>

</databaseChangeLog>

